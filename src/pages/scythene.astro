---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Footer from '../components/Footer.astro';
import { SCYTHENE_PRODUCTS as products } from '../data/scythene-catalog';
import { scytheneProductUrl, scytheneShopUrl } from '../lib/affiliate';

// Claims policy: no testing / certification / anti-doping language on this page.
// Trust language mirrors scythene.com exactly. Enforced by scripts/check-funnel.mjs.
const pillars = [
  {
    icon: '&#128203;',
    title: 'Transparent Labels',
    description: 'You see the ingredients and the doses. No marketing hiding behind a Supplement Facts panel you can\'t read.',
  },
  {
    icon: '&#128218;',
    title: 'Evidence-Based',
    description: 'Every product in the line exists because the research supports the ingredient — not because it trends on social media.',
  },
  {
    icon: '&#127981;',
    title: 'GMP-Certified Manufacturing',
    description: 'Products are manufactured in GMP-certified US facilities.',
  },
];

const available = products.filter(p => p.available);
const comingSoon = products.filter(p => !p.available);
const shopUrl = scytheneShopUrl('scythene-page', 'store-page');
---

<Layout title="Scythene | Supplements | Combat Dietitian" description="Evidence-based supplements with transparent labels, manufactured in GMP-certified US facilities. Curated by the registered dietitian behind Combat Dietitian.">
  <Nav />

  <Hero
    title='<span class="text-gold-400">Scythene</span><br />Supplements'
    subtitle="Evidence-based supplements with transparent labels, manufactured in GMP-certified US facilities. Curated by a registered dietitian for athletes who demand to see every dose."
    cta={{ label: 'Shop Now', href: shopUrl }}
    secondaryCta={{ label: 'View Products Below', href: '#products' }}
  />

  <!-- Intro -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <img src="/brand/scythene-logo-white.png" alt="Scythene Supplements" width="1200" height="610" class="mx-auto h-28 sm:h-32 w-auto" loading="lazy" decoding="async" />
      <p class="mt-8 text-lg text-white/70 leading-relaxed text-left">
        Scythene is the supplement line curated by the registered dietitian behind Combat Dietitian. Every product is chosen because the research supports the ingredient, labeled so you can see what you're taking, and manufactured in GMP-certified US facilities. <a href={shopUrl} target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-300 underline">Scythene's evidence-based supplement line at scythene.com</a> is built for combat athletes, tactical operators, and performance athletes who refuse to guess what's in their stack.
      </p>
    </div>
  </section>

  <!-- Discount Banner -->
  <section class="bg-accent-500/10 border-y border-accent-500/20">
    <div class="max-w-5xl mx-auto px-4 py-6 text-center">
      <p class="text-lg font-bold">
        <span class="text-accent-500">20% OFF</span> your first Scythene order
      </p>
      <p class="text-white/60 text-sm mt-1">
        CD Academy students &amp; Calsanova members. Code provided at enrollment.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <SectionHeading
        label="Our Philosophy"
        title="If It's Not Evidence-Based, We Don't Sell It"
      />
      <p class="text-white/60 text-lg leading-relaxed max-w-3xl mx-auto">
        Athletes deserve supplements they can read. No marketing hype masquerading as science. No labels designed to keep you from knowing what you're taking. Just evidence-based formulas with the ingredients and doses in plain sight — made in GMP-certified US facilities. Every product in our line exists because the research supports it, not because it trends on social media.
      </p>
    </div>
  </section>

  <!-- Three Pillars -->
  <section class="py-20 px-4 bg-brand-800/30">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        label="Why Scythene"
        title="Built Different"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {pillars.map(pillar => (
          <div class="bg-brand-800/40 border border-white/5 rounded-xl p-8 text-center hover:border-gold-500/30 transition-colors">
            <div class="text-4xl mb-4" set:html={pillar.icon} />
            <h3 class="text-xl font-bold mb-3">{pillar.title}</h3>
            <p class="text-white/60 leading-relaxed">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        label="Product Line"
        title="Available Now"
        subtitle="Evidence-based essentials for training, recovery, hydration, and daily foundation — prices and availability synced with scythene.com."
      />
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {available.map(product => (
          <a
            href={scytheneProductUrl(product.slug, 'scythene-page', 'store-page')}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-brand-800/40 border border-white/5 rounded-xl p-6 hover:border-gold-500/30 transition-colors group flex flex-col"
          >
            <span class="text-gold-400 text-xs font-bold uppercase tracking-widest">{product.category}</span>
            <h3 class="mt-2 text-lg font-bold group-hover:text-gold-400 transition-colors">{product.name}</h3>
            {product.variants && product.variants.length > 1 && (
              <p class="mt-1 text-xs text-white/40">{product.variants.join(' · ')}</p>
            )}
            <div class="mt-auto pt-3 flex items-baseline gap-2">
              <span class="text-white text-xl font-bold">{product.price}</span>
              <span class="text-white/40 text-sm">{product.servings}</span>
            </div>
            <span class="inline-block mt-3 self-start text-xs bg-green-500/10 text-green-400 px-2 py-0.5 rounded-full">Available</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {comingSoon.length > 0 && (
    <section class="py-20 px-4 bg-brand-800/30">
      <div class="max-w-6xl mx-auto">
        <SectionHeading
          label="Expanding"
          title="Coming Soon"
          subtitle="The full lineup — same standards, more options."
        />
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {comingSoon.map(product => (
            <div class="bg-brand-800/40 border border-white/5 rounded-xl p-5 opacity-70">
              <span class="text-white/30 text-xs font-bold uppercase tracking-widest">{product.category}</span>
              <h3 class="mt-2 text-sm font-bold text-white/70">{product.name}</h3>
              <div class="mt-2 flex items-baseline gap-2">
                <span class="text-white/50 text-lg font-bold">{product.price}</span>
              </div>
              <span class="inline-block mt-2 text-xs bg-white/5 text-white/30 px-2 py-0.5 rounded-full">Coming Soon</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Who It's For -->
  <section class="py-20 px-4 bg-brand-800/30">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        label="Built For"
        title="Athletes Who Read the Label"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { title: 'Combat Athletes', desc: 'Fighters who need to know exactly what\'s in their stack. Every product labeled so you can see the ingredients and doses before it goes in the shaker.' },
          { title: 'Tactical Operators', desc: 'Military, law enforcement, and first responders who can\'t afford to gamble on a mystery formula. Transparent labels, GMP-certified US manufacturing.' },
          { title: 'Performance Athletes', desc: 'Strength, endurance, and team-sport athletes who want research-backed ingredients without the supplement-industry noise.' },
        ].map(item => (
          <div class="bg-brand-800/40 border border-white/5 rounded-xl p-8">
            <h3 class="text-xl font-bold mb-3">{item.title}</h3>
            <p class="text-white/60 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it's for closing -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-lg text-white/70 leading-relaxed">
        Whether you train for competition or duty, you can <a href={shopUrl} target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-300 underline">browse the full Scythene catalog</a> and read every label before you buy. No surprises. No fine print.
      </p>
    </div>
  </section>

  <Ecosystem current="scythene" />

  <!-- CTA -->
  <section class="py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">
        Curated by a Dietitian. <span class="text-gold-400">Built for Athletes.</span>
      </h2>
      <p class="mt-4 text-white/60 text-lg">
        Evidence-based supplements. Transparent labels. GMP-certified manufacturing.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={shopUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-gold-500 hover:bg-gold-400 text-brand-900 font-semibold px-8 py-3.5 rounded-lg text-lg transition-colors"
        >
          Shop Scythene
        </a>
        <a
          href="/contact"
          class="border border-white/20 hover:border-white/40 text-white font-medium px-8 py-3.5 rounded-lg text-lg transition-colors"
        >
          Book a Consultation
        </a>
      </div>
      <p class="mt-4 text-accent-500 text-sm font-medium">
        20% off for CD Academy students and Calsanova members
      </p>
      <p class="mt-6 text-sm text-white/40">
        See the full product line and every label at <a href={shopUrl} target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-300 underline">scythene.com</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

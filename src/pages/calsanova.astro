---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ecosystem from '../components/Ecosystem.astro';
import Footer from '../components/Footer.astro';

const features = [
  {
    icon: '&#128247;',
    title: 'AI Nutrition Engine',
    description: 'Photo-based food logging with instant macro estimation, plus AI meal plans periodized to your training day — heavy, light, rest, or fight week.',
  },
  {
    icon: '&#127947;',
    title: 'Training & Periodization',
    description: 'Program builder, training log, load management, and deload guidance. Nutrition targets move with the block instead of sitting on a static number.',
  },
  {
    icon: '&#128164;',
    title: 'Recovery & Readiness',
    description: 'Sleep, stress, and readiness check-ins that tell you — and your dietitian — when to push and when to back off.',
  },
  {
    icon: '&#9000;',
    title: 'Wearable Integration',
    description: 'Sync Apple Health, Garmin, Oura, Fitbit, WHOOP, and Polar for a complete picture of training load, HRV, and recovery.',
  },
  {
    icon: '&#129514;',
    title: 'Labs & Body Composition',
    description: 'Track blood work over time with threshold alerts, log body-composition trends, and forecast weight against a competition date.',
  },
  {
    icon: '&#9878;',
    title: 'Weight-Cut Tools',
    description: 'Water-loading, sweat-rate, and weight-prediction calculators built for weight-class athletes — the same math we run in fight camp.',
  },
  {
    icon: '&#128200;',
    title: 'Performance Analytics',
    description: 'One dashboard tying intake, training, and recovery together. Your dietitian reviews the same data in real time.',
  },
  {
    icon: '&#127909;',
    title: 'Video Consults + Kiwi',
    description: 'Built-in video sessions with AI-generated SOAP notes, plus Kiwi — a PubMed-backed research assistant for evidence-based answers.',
  },
];
---

<Layout title="Calsanova | AI Performance Optimization Platform | Combat Dietitian" description="Calsanova is the AI performance optimization platform behind Combat Dietitian — nutrition, training load, recovery, sleep, wearables, and lab data in one adaptive system. Included with every MPS consultation.">
  <Nav />

  <Hero
    logo={{ src: '/brand/calsanova-logo.png', alt: 'Calsanova', width: 1200, height: 293, class: 'h-16 sm:h-24 md:h-28' }}
    title='AI Performance <span class="text-gold-400">Optimization</span> Platform'
    subtitle="The technology behind Combat Dietitian. Nutrition is one input — Calsanova connects it to training load, recovery, sleep, wearables, and lab data, then adapts your plan as the numbers change. Every client gets full access."
    cta={{ label: 'Get Access — Book a Consultation', href: '/contact' }}
    secondaryCta={{ label: 'Explore the Calsanova Platform →', href: 'https://calsanova.com' }}
  />

  <!-- Intro -->
  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-lg text-white/70 leading-relaxed text-left">
        Calsanova is a performance optimization platform, not a food diary. It was built for the athletes Combat Dietitian serves — operators on rotating shifts, fighters cutting weight, athletes whose fueling has to track their training block. From AI meal planning and photo-based logging to training periodization, readiness tracking, blood-work trends, and HIPAA-compliant video consultations, <a href="https://calsanova.com" target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-300 underline">Calsanova's platform at calsanova.com</a> puts every input in one place — so your dietitian can focus on strategy while the software handles the rest.
      </p>
    </div>
  </section>

  <!-- Features grid -->
  <section class="py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        label="Platform Features"
        title="Everything That Drives Performance, in One System"
        subtitle="Calsanova replaces your food diary, training log, recovery tracker, and research tools — one adaptive platform powered by AI."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map(feature => (
          <div class="bg-brand-800/40 border border-white/5 rounded-xl p-7 hover:border-gold-500/30 transition-colors">
            <div class="text-3xl mb-4" set:html={feature.icon} />
            <h3 class="text-lg font-bold mb-2">{feature.title}</h3>
            <p class="text-white/60 text-sm leading-relaxed">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Platform screenshots -->
  <section class="py-20 px-4 bg-brand-800/30">
    <div class="max-w-6xl mx-auto">
      <SectionHeading
        label="See It in Action"
        title="Built for Performance Athletes"
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { src: '/athlete-dashboard.jpg', alt: 'Athlete dashboard with nutrition overview and analytics' },
          { src: '/meal-plan.jpg', alt: 'AI-generated meal plan periodized to a training day' },
          { src: '/recipes.jpg', alt: 'Recipe library with macro-calculated meals' },
        ].map(img => (
          <div class="bg-brand-800/60 border border-white/10 rounded-xl overflow-hidden">
            <img src={img.src} alt={img.alt} class="w-full h-auto" loading="lazy" decoding="async" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <SectionHeading
        label="How It Works"
        title="From Data to Decision"
      />

      <div class="space-y-8">
        {[
          { step: '01', title: 'Connect Your Data', description: 'Log meals by photo, sync your wearable, enter training sessions and labs. AI handles the macro math and the trend lines.' },
          { step: '02', title: 'Get Your Plan', description: 'Receive nutrition and training targets periodized to your block, goals, schedule, and preferences — and re-generated when the block changes.' },
          { step: '03', title: 'Track Readiness & Adjust', description: 'Watch intake, load, sleep, and recovery on one dashboard. Your dietitian reviews the same data and adjusts in real time.' },
          { step: '04', title: 'Consult Live', description: 'Jump into a video session with your dietitian. AI generates SOAP notes and action items automatically.' },
        ].map(item => (
          <div class="flex items-start gap-6">
            <span class="text-accent-500 text-3xl font-black shrink-0 w-12">{item.step}</span>
            <div>
              <h3 class="text-xl font-bold">{item.title}</h3>
              <p class="text-white/60 mt-1">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="py-16 px-4 bg-brand-800/30">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-lg text-white/70 leading-relaxed">
        Whether you're a competing athlete periodizing a fight camp, an operator fueling around a rotation, or a practitioner managing a roster of performance clients, you can <a href="https://calsanova.com" target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-300 underline">create your Calsanova account</a> and start using the full platform immediately after booking a Combat Dietitian consultation.
      </p>
    </div>
  </section>

  <Ecosystem current="calsanova" />

  <!-- CTA -->
  <section class="py-20 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold">
        Calsanova Is Included with Every <span class="text-accent-500">MPS</span> Consultation
      </h2>
      <p class="mt-4 text-white/60 text-lg">
        No separate subscription. No extra fees. Book a consultation and get immediate access to the full platform.
      </p>
      <a
        href="/contact"
        class="inline-block mt-8 bg-gold-500 hover:bg-gold-400 text-brand-900 font-semibold px-8 py-3.5 rounded-lg text-lg transition-colors"
      >
        Book Your Consultation
      </a>
      <p class="mt-6 text-sm text-white/40">
        Prefer to explore the software first? <a href="https://calsanova.com" target="_blank" rel="noopener noreferrer" class="text-gold-400 hover:text-gold-300 underline">Visit calsanova.com</a> to see it in action.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

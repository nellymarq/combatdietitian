---
import SectionHeading from './SectionHeading.astro';

interface Props {
  /** Which brand page we're currently on — that one won't be a link */
  current?: 'combat-dietitian' | 'calsanova' | 'scythene';
}

const { current } = Astro.props;

const brands = [
  {
    id: 'combat-dietitian',
    name: 'Combat Dietitian',
    href: '/services',
    logo: { src: '/brand/cd-lockup.png', width: 1600, height: 441, class: 'h-12' },
    description: 'Performance nutrition consulting for fighters, operators, and weight-class athletes.',
    border: 'hover:border-accent-500/30',
  },
  {
    id: 'calsanova',
    name: 'Calsanova',
    href: '/calsanova',
    logo: { src: '/brand/calsanova-logo.png', width: 1200, height: 293, class: 'h-9' },
    description: 'AI performance optimization platform — nutrition, training, recovery, and analytics in one system.',
    border: 'hover:border-gold-500/30',
  },
  {
    id: 'scythene',
    name: 'Scythene',
    href: '/scythene',
    logo: { src: '/brand/scythene-logo-white.png', width: 1200, height: 610, class: 'h-14' },
    description: 'Evidence-based supplements with transparent labels, made in GMP-certified US facilities.',
    border: 'hover:border-white/20',
  },
];
---

<section class="py-20 px-4 bg-brand-800/30">
  <div class="max-w-4xl mx-auto text-center">
    <SectionHeading
      label="The MPS Ecosystem"
      title="Consulting + Performance Platform + Supplements"
      subtitle="Everything under Marques Performance Systems — built to work together."
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {brands.map(brand => {
        const isCurrent = brand.id === current;
        const card = (
          <>
            <div class="h-16 flex items-center justify-center">
              <img
                src={brand.logo.src}
                alt={brand.name}
                width={brand.logo.width}
                height={brand.logo.height}
                class:list={['w-auto max-w-full', brand.logo.class]}
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="text-white/50 text-sm mt-4">{brand.description}</p>
          </>
        );
        return isCurrent ? (
          <div class="bg-brand-800/40 border border-accent-500/20 rounded-xl p-6">
            {card}
            <span class="inline-block mt-3 text-xs text-white/30">You are here</span>
          </div>
        ) : (
          <a href={brand.href} class:list={['block bg-brand-800/40 border border-white/5 rounded-xl p-6 transition-colors', brand.border]}>
            {card}
          </a>
        );
      })}
    </div>
  </div>
</section>
